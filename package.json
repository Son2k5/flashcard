{
  "name": "vocab-flashcards",
  "version": "2.0.0",
  "private": true,
  "description": "Ứng dụng từ vựng tĩnh, không cần build. Dependency chỉ dùng cho test Node.",
  "scripts": {
    "build": "node scripts/sync-env.cjs",
    "sync-env": "node scripts/sync-env.cjs",
    "set-access-code": "node scripts/set-access-code.cjs",
    "test": "node tests/core.test.cjs && node tests/excel-import.test.cjs && node tests/storage.test.cjs && node tests/quiz-import.test.cjs && node tests/quiz-pdf-highlight.test.cjs",
    "test:excel-browser": "node tests/excel-import.browser.cjs",
    "test:quiz-browser": "node tests/quiz-import.browser.cjs && node tests/quiz-mixed.browser.cjs",
    "test:quiz-flashcard": "node tests/quiz-flashcard.browser.cjs",
    "test:responsive": "node tests/responsive.browser.cjs",
    "test:content-browser": "node tests/manual-content.browser.cjs",
    "test:resume-browser": "node tests/quiz-resume.browser.cjs"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "linkedom": "0.18.12",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "playwright": "^1.64.0"
  }
}
